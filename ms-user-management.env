# ms-user-management — Environment variables for local development
# Port: 3007 | DB: eduaircontrol_user_management | Schema: user_management

SERVER_PORT=3007
POSTGRES_URL=jdbc:postgresql://localhost:5432/eduaircontrol_user_management
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev

# Shared HS256 JWT secret (interim, ADR-006 pending)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRATION=86400000

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
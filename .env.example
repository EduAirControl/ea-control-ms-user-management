# Variables de entorno para ms-user-management
# Copia este archivo a .env y ajusta los valores

# Servidor
SERVER_PORT=3007

# Base de datos
POSTGRES_URL=jdbc:postgresql://localhost:5438/eduaircontrol_user_management
POSTGRES_USER=user_management_user
POSTGRES_PASSWORD=user_management_pass

# JWT/JWKS
AUTH_JWKS_URI=http://localhost:8081/api/v1/auth/jwks

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Observabilidad
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,prometheus